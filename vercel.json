{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "/alexdorokhina/uploads/$1" },
    { "source": "/assets/(.*)", "destination": "/alexdorokhina/assets/$1" },
    { "source": "/anastasiia.jpeg", "destination": "/anastasiia.jpeg" },
    { "source": "/slavic.bestie", "destination": "/slavic.bestie/index.html" },
    { "source": "/slavic.bestie/(.*)", "destination": "/slavic.bestie/$1" },
    { "source": "/alexdorokhina", "destination": "/alexdorokhina/index.html" },
    { "source": "/alexdorokhina/(.*)", "destination": "/alexdorokhina/$1" }
  ]
}
